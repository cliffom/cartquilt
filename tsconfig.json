{
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "web/src",
    "types": ["vite/client"],
    "outDir": ".local/test-js",
    "noEmitOnError": true
  },
  "include": ["web/src"]
}
