{
  "name": "cartquilt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && go run ./cmd/cartquilt",
    "test": "npm run build && go test ./... && node --test tests/*.test.mjs",
    "format": "gofmt -w cmd && biome format --write",
    "format:check": "node scripts/check-go-format.mjs && biome format",
    "lint": "go vet ./... && biome lint --error-on-warnings && tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "typescript": "5.9.3"
  }
}
